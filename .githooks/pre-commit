#!/bin/sh
# The typical Rust check flow, gating every commit.
# Enable with: git config core.hooksPath .githooks
set -e

run() {
    echo "pre-commit: $*"
    "$@"
}

# Check the staged snapshot, not the working tree: with partially staged
# files the two differ, and only the index becomes the commit.
repo=$(git rev-parse --show-toplevel)
snapshot=$(mktemp -d)
# cd back out first: Windows cannot delete the current working directory.
trap 'cd "$repo" && rm -rf "$snapshot" || :' EXIT INT HUP TERM
git checkout-index --prefix="$snapshot/" -a
# Reuse a build cache across runs, separate from the dev target dir.
CARGO_TARGET_DIR="$repo/target/pre-commit"
export CARGO_TARGET_DIR
cd "$snapshot"

run cargo fmt --check
run cargo check --all-targets --all-features --quiet
run cargo clippy --all-targets --all-features --quiet -- -D warnings
run cargo test --all-features --quiet
run env RUSTDOCFLAGS="-D warnings" cargo doc --no-deps --all-features --quiet

# Also lint the other platform's module via a cross target (unix.rs is
# invisible to every native check on Windows and vice versa; cargo clippy
# doesn't link, so no cross toolchain is needed). Skipping this silently
# would let cross-platform breakage land, so a missing target fails the
# commit instead.
host=$(rustc -vV | sed -n 's/^host: //p')
case "$host" in
    *-windows-*) cross=x86_64-unknown-linux-musl ;;
    *) cross=x86_64-pc-windows-msvc ;;
esac
if ! rustup target list --installed 2>/dev/null | grep -qx "$cross"; then
    echo "pre-commit: cross target $cross is not installed, so the other" >&2
    echo "pre-commit: platform's module cannot be linted; fix with:" >&2
    echo "pre-commit:     rustup target add $cross" >&2
    exit 1
fi
run cargo clippy --all-targets --all-features --quiet --target "$cross" -- -D warnings
